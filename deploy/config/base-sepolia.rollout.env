# Base Sepolia rollout inputs (decisions 47-50). Addresses and placeholders only: NO private keys here.
# Keys (DEPLOYER_PRIVATE_KEY, CARD_SETTLER_PRIVATE_KEY, ...) stay in each operator's own environment or Railway.
# Load with: set -a; . deploy/config/base-sepolia.rollout.env; set +a
# Owner-approved on Nov 16, 2026. Read-only check of Base Sepolia the same day: ESADepositVault, ClaimEscrow,
# ClearUSDUpgradeable and LendingPool all have DEFAULT_ADMIN_ROLE held by the deployer wallet ...7AAA; the Safe
# below (v1.3.0, owners ...7AAA, ...86cF, ...eFE5) is ClaimEscrow's PAYOUT_TREASURY; RevolvingIssuer approves the
# card settler below.

# One Safe plays every Safe role on testnet (owner: leave the Safe's settings alone for now; see SAFE_NEW_OWNER).
CLEAR_FINANCIAL_SAFE=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
CLEAR_LENDING_SAFE=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
OPS_SAFE=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
COOP_TREASURY=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50

# Where Yield Pool Deployments are sent (Clear Lending's account).
CLEAR_LENDING_ACCOUNT=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50

# Who holds the vault's DEFAULT_ADMIN_ROLE today (read on chain): the deployer wallet.
VAULT_ADMIN=0x895d44d10d1b7B4F5f38E2ae2322539Cf93F7AAA
# The deployer wallet's address (MetaMask): it sends D4's grants and the Liquidator HOLD_ROLE grants by hand
# (scripts/signing_plan.ts), and scripts/check_sepolia_wiring.ts reads it.
DEPLOYER=0x895d44d10d1b7B4F5f38E2ae2322539Cf93F7AAA

# The API's card settler wallet (its key is CARD_SETTLER_PRIVATE_KEY on Railway).
CARD_SETTLER_ADDRESS=0x1b535bbe4bc5f1a4152dfbd1d1215d9435ead4f3

# Placeholders for testnet: keccak256 of a short text naming each as a test placeholder.
# EARN_RESOLUTION = keccak256("Clear Lending Board resolution: Earn role grants (Base Sepolia test placeholder)")
EARN_RESOLUTION=0x605c8486f34c4b42827a7b0027f9713459d7d22795e19b95a02f32949ea67e78
# POOL_TIER_EVIDENCE = keccak256("Pool Tier valuation (Base Sepolia test placeholder)")
POOL_TIER_EVIDENCE=0x273e44a21ee3907847a8caca6a4ce5d85ec814c9825bb98f2b55f255e99dfb7f
# Pool Tier principal: $100,000 in USDC base units (6 decimals).
POOL_TIER_PRINCIPAL=100000000000

# The pool's Initial Closing (unix seconds): Nov 16, 2026 00:00 UTC. On testnet it only sets when the test pool's
# term would end; the first share issue could not be found through the public RPC.
INITIAL_CLOSING=1794787200

# Base Sepolia USDC (Circle).
RESERVE_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BOND_TOKEN=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ---- Added by the fork rehearsal (docs/audit/SEPOLIA-REHEARSAL.md), Nov 16, 2026: values the records, the chain or
# the docs settle. Read on a fork of Base Sepolia at block 59452173.
# Deploy 20: where carry lands and Lending Co.'s operating address. Deploy 20 asks for "the co-op multisig" and
# Lending Co. is CLEAR_LENDING_ACCOUNT; one Safe plays every Safe role on testnet.
CARRY_TREASURY=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
LENDER_OPERATING=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
# Deploy 25: the old RevolvingIssuer's cardSettlementAccount() and the old TermIssuer's feeRecipient() are this Safe.
CARD_SETTLEMENT_ACCOUNT=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
FEE_RECIPIENT=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
# Deploy 08: the co-op board Safe (one Safe plays every Safe role).
BOARD_SAFE=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
# Deploys 22 and 23: the recorded factory's baseURI.
BOND_BASE_URI=ipfs://clear-bonds/
# Deploy 23: above every id an older collection issued. BurnerBondLegacy issued ids 1 to 3 (all redeemed) and the
# current pre-2f BurnerBond none; 1000 leaves room for a sale before the run. Re-check with step B1's report.
FIRST_BOND_ID=1000

# ---- Signer pairs (owner-approved Nov 16, 2026). Testnet only, mainnet gets its own people. Every signer is a
# MetaMask account, so the owner can sign each step on the signing page: …698a, Account 3 (0x608d…7c23) and
# Account 4 (0xA0e1…d8a7). The deployer (…7AAA) is in none of these pairs: the handovers renounce every vault and
# CLRUSD role it holds. The Privy wallets (…86cF and …eFE5, two of the Safe's owners) hold no role: they can only
# sign inside the members app.
VAULT_PAUSERS=0x558D4318071EBC15e7ED13d8e880Dc1D17A7698a,0x608d8A767C4Bf5063f5FA5DfE29F31DA3BF77c23
PILOT_SIGNERS=0x558D4318071EBC15e7ED13d8e880Dc1D17A7698a,0xA0e10CCAd487937195A0b756fc1055cd810Bd8a7
FRAUD_SIGNERS=0x608d8A767C4Bf5063f5FA5DfE29F31DA3BF77c23,0xA0e10CCAd487937195A0b756fc1055cd810Bd8a7
SECURITY_SIGNERS=0x608d8A767C4Bf5063f5FA5DfE29F31DA3BF77c23,0xA0e10CCAd487937195A0b756fc1055cd810Bd8a7
LISTING_SIGNERS=0x558D4318071EBC15e7ED13d8e880Dc1D17A7698a,0xA0e10CCAd487937195A0b756fc1055cd810Bd8a7
ASSURANCE_SIGNERS=0x608d8A767C4Bf5063f5FA5DfE29F31DA3BF77c23,0xA0e10CCAd487937195A0b756fc1055cd810Bd8a7
# Not scripted (steps D4 and E9): who gets the credit settings, credit attester and Liquidator hold roles.
CREDIT_SETTINGS_SIGNERS=0x558D4318071EBC15e7ED13d8e880Dc1D17A7698a,0x608d8A767C4Bf5063f5FA5DfE29F31DA3BF77c23
CREDIT_ATTESTER_SIGNERS=0x608d8A767C4Bf5063f5FA5DfE29F31DA3BF77c23,0xA0e10CCAd487937195A0b756fc1055cd810Bd8a7
HOLD_SIGNERS=0x558D4318071EBC15e7ED13d8e880Dc1D17A7698a,0xA0e10CCAd487937195A0b756fc1055cd810Bd8a7

# Collateral Agent (deploy 26). The Agent Key may not also be a treasury signer (the contract refuses it).
TREASURY_SIGNERS=0x608d8A767C4Bf5063f5FA5DfE29F31DA3BF77c23,0xA0e10CCAd487937195A0b756fc1055cd810Bd8a7
AGENT_KEY=0x558D4318071EBC15e7ED13d8e880Dc1D17A7698a
COLLATERAL_ACCOUNT=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
AGENT_COST_ADDRESS=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
EXCESS_DESTINATION=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50

# ---- The Safe before the handovers (owner decision, Nov 16, 2026): instead of changeThreshold(2), the Safe calls
# addOwnerWithThreshold(SAFE_NEW_OWNER, SAFE_THRESHOLD). Its other two owners are Privy wallets usable only inside the
# members app; the deployer (…7AAA) and SAFE_NEW_OWNER are MetaMask. scripts/signing_plan.ts writes the Safe batch.
SAFE_NEW_OWNER=0x558D4318071EBC15e7ED13d8e880Dc1D17A7698a
SAFE_THRESHOLD=2

# ---- The API's job wallets (addresses only; keys stay with CDP or Railway).
# Savings and send relayer on Base Sepolia: ONE Coinbase CDP wallet, "savings-relayer-base-sepolia" (Railway:
# SAVINGS_CDP_EVM_ACCOUNT_ADDRESS and the send relayer's 84532 override both name it). Read on chain Nov 16, 2026:
# it holds the vault's OPERATOR_ROLE (moves to RELAYER_ROLE, audit H-3), ClaimEscrow and SavingsIntentFactory
# SETTLER_ROLE and CollateralRegistry OPERATOR_ROLE. (Base mainnet's send relayer is another CDP wallet, 0xFDd1…777C.)
RELAYER=0x6Cbdf4469856C70C07C95a6c276c218F64e0Fcb3
VAULT_RELAYERS=0x6Cbdf4469856C70C07C95a6c276c218F64e0Fcb3
SAVINGS_RELAYER_ADDRESS=0x6Cbdf4469856C70C07C95a6c276c218F64e0Fcb3
SEND_RELAYER_ADDRESS=0x6Cbdf4469856C70C07C95a6c276c218F64e0Fcb3
# Credit operator (CREDIT_OPERATOR_PRIVATE_KEY on Railway): read from the API's "[wallets]" startup line on Nov 16, 2026
# and checked on chain (a plain wallet, already the old AccessManager's operator; not the deployer). The API signs line
# opening AND term limits with this one key, so it takes both CREDIT_LINES_ROLE and CREDIT_LIMITS_ROLE on the fresh
# AccessManager, the operator (D4) and, by ops-roles.map.json, MembershipRegistry's REGISTRAR_ROLE (I1).
CREDIT_OPERATOR_ADDRESS=0x8801A480Cd6a2Ab40964d3895d5BED8fCfa51edd
CREDIT_LINES_KEY=0x8801A480Cd6a2Ab40964d3895d5BED8fCfa51edd
CREDIT_LIMITS_KEY=0x8801A480Cd6a2Ab40964d3895d5BED8fCfa51edd
# ops-roles.ts (I1) names the Ops Safe SAFE_ADDRESS: one Safe plays every Safe role on testnet.
SAFE_ADDRESS=0x52e6102B7C22eeC7A68B11Dd71faC7D6D9AEcf50
# STATE_ATTESTER_KEY is left unset on purpose: nothing in the API calls NetworkRegistry.attestStateCode today, so no
# one is granted STATE_ATTESTER_ROLE (deploy 25 skips it). Set it when a service starts attesting members' states.
