{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // Tests run under bun, which types `bun:test` itself — the same reason apps/member excludes
  // them from its build. `bun test` still typechecks them as it runs them.
  "exclude": ["src/**/*.test.ts"]
}
