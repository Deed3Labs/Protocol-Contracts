{
  "installCommand": "cd ../.. && npm install --workspace=@clear/member --no-audit --no-fund",
  "buildCommand": "cd ../.. && npx turbo run build:vercel --filter=@clear/member",
  "ignoreCommand": "bash ../../scripts/vercel-ignore.sh apps/member",
  "rewrites": [
    {
      "source": "/p/(.*)",
      "destination": "/phone.html"
    },
    {
      "source": "/r/(.*)",
      "destination": "/phone.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/docs/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
