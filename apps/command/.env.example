# The Clear app's Privy app (public). The same one apps/member uses.
VITE_PRIVY_APP_ID=
# The API: protocol-contracts-dev on Railway for dev, http://localhost:3001 for a local API.
VITE_API_BASE_URL=http://localhost:3001
# The merchants map (Phase 7d): OpenFreeMap's positron unless this is set. A Mapbox style
# (mapbox://styles/… or https://api.mapbox.com/styles/v1/…) needs its public token; a secret sk. token
# is never used.
VITE_MAP_STYLE_URL=
VITE_MAPBOX_TOKEN=
