# apps/pay (pay.useclear.org, js.useclear.org): the Vercel project `clear-pay`.
#
# The API the pages and the modal call. Baked in at build time (Vite). Preview and Development point at
# the dev API (Railway `dev`, which the dev-pinned domains use); Production at the production API.
VITE_API_BASE_URL=http://localhost:3001

# The same API, for the /m/:session function that sets frame-ancestors (api/frame.ts), at run time.
PAY_API_URL=http://localhost:3001
