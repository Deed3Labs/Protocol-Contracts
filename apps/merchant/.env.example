# The API this counter talks to. Without it the app falls back to http://localhost:3001, which on a
# deployed tablet means every request fails with nothing useful on screen.
VITE_API_BASE_URL=https://protocol-contracts-dev.up.railway.app

# Privy, for owner sign-in only. Counter staff have no Privy account — a shift is a PIN against
# Clear's own roster. This is a PUBLIC identifier: it ships in the bundle by design, and what
# protects it is Privy's allowed-origins list, not secrecy. The app secret is server-side and must
# never appear here.
VITE_PRIVY_APP_ID=

# Where a scanned charge code lands — the MEMBER app, not this one. The customer scans with their
# own phone and needs the screen that approves a charge. Pointing this at production while the
# counter is on testnet sends customers to a different chain than the charge was raised on.
VITE_MEMBER_APP_URL=https://demo.useclear.org
