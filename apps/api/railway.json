{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/api/**",
      "src/**",
      "package.json",
      "bun.lock",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "bun src/index.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
