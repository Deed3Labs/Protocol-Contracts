{
  "name": "@clear/api",
  "version": "1.0.0",
  "description": "Backend server with Redis caching for Protocol Contracts app",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist",
    "start": "bun src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "bun test-api.ts",
    "plaid:backfill-member-ownership": "node scripts/backfill-plaid-member-ownership.mjs",
    "send:cdp:account": "node scripts/cdp-relayer-account.mjs",
    "send:recover-claim": "node scripts/send-recover-claim-link.mjs",
    "lithic:provision-test-member": "node scripts/lithic-provision-test-member.mjs",
    "lithic:verify-step2": "node scripts/lithic-verify-step2.mjs",
    "lithic:build-asa": "tsc --outDir dist --module esnext --moduleResolution bundler --target es2022 --skipLibCheck src/routes/lithicAuthStream.ts src/services/lithic/authStore.ts src/services/lithic/authDecision.ts src/config/postgres.ts",
    "lithic:verify-step3": "npm run lithic:build-asa && node scripts/lithic-verify-step3.mjs",
    "lithic:test": "bun test src/services",
    "lithic:verify-step8": "node scripts/lithic-verify-step8.mjs",
    "lithic:verify-asa": "node scripts/lithic-verify-asa.mjs"
  },
  "dependencies": {
    "@clear/domain": "file:../../packages/domain",
    "@coinbase/cdp-sdk": "^1.41.0",
    "@privy-io/node": "0.34.0",
    "@privy-io/server-auth": "^1.32.5",
    "@types/pg": "^8.16.0",
    "@types/socket.io": "^3.0.1",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/permissions": "^5.5.14",
    "@zerodev/sdk": "^5.5.10",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.15.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "lithic": "^0.145.0",
    "pg": "^8.18.0",
    "plaid": "^41.1.0",
    "redis": "^4.6.12",
    "socket.io": "^4.8.3",
    "stripe": "^18.5.0",
    "viem": "^2.53.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "license": "UNLICENSED"
}
